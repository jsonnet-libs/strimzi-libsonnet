            '#withOptional':: d.fn(help='', args=[d.arg(name='optional', type=d.T.boolean)]),
            withOptional(optional): { spec+: { kafka+: { metricsConfig+: { valueFrom+: { configMapKeyRef+: { optional: optional } } } } } },
          },
        },
        '#values':: d.obj(help='"Configuration values for the Strimzi Metrics Reporter."'),
        values: {
          '#withAllowList':: d.fn(help='"A list of regex patterns to filter the metrics to collect. Should contain at least one element."', args=[d.arg(name='allowList', type=d.T.array)]),
          withAllowList(allowList): { spec+: { kafka+: { metricsConfig+: { values+: { allowList: if std.isArray(v=allowList) then allowList else [allowList] } } } } },
          '#withAllowListMixin':: d.fn(help='"A list of regex patterns to filter the metrics to collect. Should contain at least one element."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowList', type=d.T.array)]),
          withAllowListMixin(allowList): { spec+: { kafka+: { metricsConfig+: { values+: { allowList+: if std.isArray(v=allowList) then allowList else [allowList] } } } } },
        },
        '#withType':: d.fn(help='"Metrics type. The supported types are `jmxPrometheusExporter` and `strimziMetricsReporter`. Type `jmxPrometheusExporter` uses the Prometheus JMX Exporter to expose Kafka JMX metrics in Prometheus format through an HTTP endpoint. Type `strimziMetricsReporter` uses the Strimzi Metrics Reporter to directly expose Kafka metrics in Prometheus format through an HTTP endpoint."', args=[d.arg(name='type', type=d.T.string)]),
        withType(type): { spec+: { kafka+: { metricsConfig+: { type: type } } } },
      },
      '#quotas':: d.obj(help='"Quotas plugin configuration for Kafka brokers allows setting quotas for disk usage, produce/fetch rates, and more. Supported plugin types include `kafka` (default) and `strimzi`. If not specified, the default `kafka` quotas plugin is used."'),
      quotas: {
        '#withConsumerByteRate':: d.fn(help="\"A per-broker byte-rate quota for clients consuming from a broker, independent of their number. If clients consume at maximum speed, the quota is shared equally between all non-excluded consumers. Otherwise, the quota is divided based on each client's consumption rate.\"", args=[d.arg(name='consumerByteRate', type=d.T.integer)]),
        withConsumerByteRate(consumerByteRate): { spec+: { kafka+: { quotas+: { consumerByteRate: consumerByteRate } } } },
        '#withControllerMutationRate':: d.fn(help='"The default client quota on the rate at which mutations are accepted per second for create topic requests, create partition requests, and delete topic requests, defined for each broker. The mutations rate is measured by the number of partitions created or deleted. Applied on a per-broker basis."', args=[d.arg(name='controllerMutationRate', type=d.T.number)]),
        withControllerMutationRate(controllerMutationRate): { spec+: { kafka+: { quotas+: { controllerMutationRate: controllerMutationRate } } } },
        '#withExcludedPrincipals':: d.fn(help='"List of principals that are excluded from the quota. The principals have to be prefixed with `User:`, for example `User:my-user;User:CN=my-other-user`."', args=[d.arg(name='excludedPrincipals', type=d.T.array)]),
        withExcludedPrincipals(excludedPrincipals): { spec+: { kafka+: { quotas+: { excludedPrincipals: if std.isArray(v=excludedPrincipals) then excludedPrincipals else [excludedPrincipals] } } } },
        '#withExcludedPrincipalsMixin':: d.fn(help='"List of principals that are excluded from the quota. The principals have to be prefixed with `User:`, for example `User:my-user;User:CN=my-other-user`."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='excludedPrincipals', type=d.T.array)]),
        withExcludedPrincipalsMixin(excludedPrincipals): { spec+: { kafka+: { quotas+: { excludedPrincipals+: if std.isArray(v=excludedPrincipals) then excludedPrincipals else [excludedPrincipals] } } } },
        '#withMinAvailableBytesPerVolume':: d.fn(help='"Stop message production if the available size (in bytes) of the storage is lower than or equal to this specified value. This condition is mutually exclusive with `minAvailableRatioPerVolume`."', args=[d.arg(name='minAvailableBytesPerVolume', type=d.T.integer)]),
        withMinAvailableBytesPerVolume(minAvailableBytesPerVolume): { spec+: { kafka+: { quotas+: { minAvailableBytesPerVolume: minAvailableBytesPerVolume } } } },
        '#withMinAvailableRatioPerVolume':: d.fn(help='"Stop message production if the percentage of available storage space falls below or equals the specified ratio (set as a decimal representing a percentage). This condition is mutually exclusive with `minAvailableBytesPerVolume`."', args=[d.arg(name='minAvailableRatioPerVolume', type=d.T.number)]),
        withMinAvailableRatioPerVolume(minAvailableRatioPerVolume): { spec+: { kafka+: { quotas+: { minAvailableRatioPerVolume: minAvailableRatioPerVolume } } } },
        '#withProducerByteRate':: d.fn(help="\"A per-broker byte-rate quota for clients producing to a broker, independent of their number. If clients produce at maximum speed, the quota is shared equally between all non-excluded producers. Otherwise, the quota is divided based on each client's production rate.\"", args=[d.arg(name='producerByteRate', type=d.T.integer)]),
        withProducerByteRate(producerByteRate): { spec+: { kafka+: { quotas+: { producerByteRate: producerByteRate } } } },
        '#withRequestPercentage':: d.fn(help='"The default client quota limits the maximum CPU utilization of each client as a percentage of the network and I/O threads of each broker. Applied on a per-broker basis."', args=[d.arg(name='requestPercentage', type=d.T.integer)]),
        withRequestPercentage(requestPercentage): { spec+: { kafka+: { quotas+: { requestPercentage: requestPercentage } } } },
        '#withType':: d.fn(help="\"Quotas plugin type. Currently, the supported types are `kafka` and `strimzi`. `kafka` quotas type uses Kafka's built-in quotas plugin. `strimzi` quotas type uses Strimzi quotas plugin.\"", args=[d.arg(name='type', type=d.T.string)]),
        withType(type): { spec+: { kafka+: { quotas+: { type: type } } } },
      },
      '#rack':: d.obj(help='"Configuration of the `broker.rack` broker config."'),
      rack: {
        '#withEnvVarName':: d.fn(help='"The name of the environment variable that defines the rack ID. Its value sets the `broker.rack` configuration for Kafka brokers and the `client.rack` configuration for Kafka Connect or MirrorMaker 2."', args=[d.arg(name='envVarName', type=d.T.string)]),
        withEnvVarName(envVarName): { spec+: { kafka+: { rack+: { envVarName: envVarName } } } },
        '#withTopologyKey':: d.fn(help="\"A key that matches labels assigned to the Kubernetes cluster nodes. The value of the label is used to set a broker's `broker.rack` config, and the `client.rack` config for Kafka Connect or MirrorMaker 2.\"", args=[d.arg(name='topologyKey', type=d.T.string)]),
        withTopologyKey(topologyKey): { spec+: { kafka+: { rack+: { topologyKey: topologyKey } } } },
        '#withType':: d.fn(help='"Specifies the rack awareness type. Supported types are `topology-label` and `environment-variable`. `topology-label` uses a Kubernetes worker node label to set the `broker.rack` configuration for Kafka brokers and the `client.rack` configuration for Kafka Connect and MirrorMaker 2. `environment-variable` uses an environment variable to set the `broker.rack` configuration for Kafka brokers and the `client.rack` configuration for Kafka Connect and MirrorMaker 2. When not specified, `topology-label` type is used by default."', args=[d.arg(name='type', type=d.T.string)]),
        withType(type): { spec+: { kafka+: { rack+: { type: type } } } },
      },
      '#readinessProbe':: d.obj(help='"Pod readiness checking."'),
      readinessProbe: {
        '#withFailureThreshold':: d.fn(help='"Minimum consecutive failures for the probe to be considered failed after having succeeded. Defaults to 3. Minimum value is 1."', args=[d.arg(name='failureThreshold', type=d.T.integer)]),
        withFailureThreshold(failureThreshold): { spec+: { kafka+: { readinessProbe+: { failureThreshold: failureThreshold } } } },
        '#withInitialDelaySeconds':: d.fn(help='"The initial delay before first the health is first checked. Default to 15 seconds. Minimum value is 0."', args=[d.arg(name='initialDelaySeconds', type=d.T.integer)]),
        withInitialDelaySeconds(initialDelaySeconds): { spec+: { kafka+: { readinessProbe+: { initialDelaySeconds: initialDelaySeconds } } } },
        '#withPeriodSeconds':: d.fn(help='"How often (in seconds) to perform the probe. Default to 10 seconds. Minimum value is 1."', args=[d.arg(name='periodSeconds', type=d.T.integer)]),
        withPeriodSeconds(periodSeconds): { spec+: { kafka+: { readinessProbe+: { periodSeconds: periodSeconds } } } },
        '#withSuccessThreshold':: d.fn(help='"Minimum consecutive successes for the probe to be considered successful after having failed. Defaults to 1. Must be 1 for liveness. Minimum value is 1."', args=[d.arg(name='successThreshold', type=d.T.integer)]),
        withSuccessThreshold(successThreshold): { spec+: { kafka+: { readinessProbe+: { successThreshold: successThreshold } } } },
        '#withTimeoutSeconds':: d.fn(help='"The timeout for each attempted health check. Default to 5 seconds. Minimum value is 1."', args=[d.arg(name='timeoutSeconds', type=d.T.integer)]),
